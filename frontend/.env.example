# Copy to .env.development.local for local development and fill in the values printed by
# `supabase status` (API URL and publishable key of the LOCAL stack).
# The deployed site gets its values from the GitHub repository variables SUPABASE_URL and
# SUPABASE_PUBLISHABLE_KEY at build time (see .github/workflows/deploy.yml). Never commit real values.
VITE_SUPABASE_URL=
VITE_SUPABASE_PUBLISHABLE_KEY=
